# Copy to .env and fill in. Never commit .env. Setup: docs/database.md

# Flask API, as bf_app (Neon pooled host)
DATABASE_URL=postgresql://bf_app:PASSWORD@HOST-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Admin stats, as bf_analytics (Neon pooled host)
ANALYTICS_DATABASE_URL=postgresql://bf_analytics:PASSWORD@HOST-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Migrations only, as bf_migrator (Neon direct host, no -pooler)
MIGRATOR_DATABASE_URL=postgresql://bf_migrator:PASSWORD@HOST.eu-west-2.aws.neon.tech/neondb?sslmode=require
